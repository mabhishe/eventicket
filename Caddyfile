# Caddy obtains and renews a TLS certificate automatically.
# The live site is eventpass.aicloudconsult.com. events.aicloudconsult.com
# is the older name in the docs — both are listed so a redeploy keeps the
# host that is actually in DNS.
eventpass.aicloudconsult.com, events.aicloudconsult.com {
	header {
		# HSTS without preload. Preload would cover every subdomain of this
		# host and is painful to undo; the apex aicloudconsult.com is a
		# different site and is not part of this file.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
	# Next sets the real CSP (script nonce, frame-ancestors 'none', and
	# the rest) and the Permissions-Policy (camera only on /door).
	# A plain Content-Security-Policy line in the block above overwrites
	# the app header on the way out, because deleting Server defers the
	# whole block until the response is written. The ? prefix is a
	# fallback written only when the app sent no CSP.
	header ?Content-Security-Policy "frame-ancestors 'none'"
	reverse_proxy app:3000
}
