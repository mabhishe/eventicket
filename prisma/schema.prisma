generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  DOOR
}

enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_STAFF
  ORG_DOOR
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum PayMethod {
  ETRANSFER
  ZELLE
  CASH
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  CANCELLED
}

enum PaymentKind {
  RECEIVED
  REFUND
  WAIVER
}

// Quota metrics a SaaS-owner temporary override can raise.
// Monthly meters reset each calendar month; static caps apply continuously.
// (Spec: eventpass-quota-override-spec.md)
enum QuotaMetric {
  MONTHLY_BOOKINGS
  MONTHLY_EMAILS
  MONTHLY_WHATSAPP
  MAX_EVENTS
  MAX_SEATS
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(SELLER) // platform-level role; per-org access comes from Membership
  emailVerified Boolean  @default(false) // true once the email address is confirmed
  sessionVersion Int     @default(0) // bumped on password change; old JWTs stop working
  createdAt     DateTime @default(now())
  soldOrders   Order[]  @relation("SellerOrders")
  confirmedOrders Order[] @relation("ConfirmedOrders")
  emergencyAdmits Order[] @relation("EmergencyAdmits")
  recordedPayments Payment[]
  events       Event[]  @relation("CreatedEvents")
  memberships  Membership[]
  verificationTokens VerificationToken[]
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the raw token — a DB leak must not grant resets
  type      String    // "VERIFY_EMAIL" | "RESET_PASSWORD"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  tagline          String?
  supportEmail     String?
  supportPhone     String?
  timezone         String   @default("America/Toronto")
  brandColor       String?
  etransferEmail   String?
  zelleHandle      String?
  cashNote         String?
  plan             String   @default("FREE") // FREE | PRO
  stripeCustomerId String?
  stripeSubscriptionId String?
  subscriptionStatus String?  @default("NONE") // NONE | ACTIVE | PAST_DUE | CANCELED
  // Platform-admin overrides (null = use plan default)
  maxEventsOverride  Int?
  maxTicketsOverride Int?
  maxSeatsOverride   Int?
  // Temporary SaaS-owner quota overrides (see OrganizationQuotaOverride).
  // Standing column overrides above are permanent; rows here MUST expire.
  quotaOverrides     OrganizationQuotaOverride[]
  // Payment inbox auto-match (Interac / Zelle adapters). Pro orgs get it;
  // paymentAutoMatchEnabled lets a Free org pilot (e.g. Canosa) without Pro.
  paymentAutoMatchEnabled Boolean @default(false)
  paymentWebhookSecretHash String? // sha256 of the bearer secret; raw secret shown once
  createdAt        DateTime @default(now())
  memberships      Membership[]
  events           Event[]
  messageTemplates MessageTemplate[]
  scheduledReminders ScheduledReminder[]
  messageLogs      MessageLog[]
  paymentIntakes   PaymentIntake[]
}

// Temporary SaaS-owner quota override for one organization.
// A ceiling lift, never a plan change: numeric quotas only, no feature gates,
// invisible to the organizer, and enforced purely by clock-read —
// a row counts only while revokedAt IS NULL AND createdAt <= now < expiresAt.
// No cron needed; expired rows are simply never read.
// (Spec: workspace/goals/event-ticketing-app-pilot/files/eventpass-quota-override-spec.md)
model OrganizationQuotaOverride {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric         QuotaMetric
  value          Int         // the ceiling while active; must be >= 0
  reason         String      // required: why this was granted (audit)
  createdBy      String      // platform admin email that granted it
  createdAt      DateTime    @default(now())
  expiresAt      DateTime    // required: ignored at/after this instant
  revokedAt      DateTime?   // set on manual revoke; ignored thereafter

  @@index([organizationId, metric])
  @@index([expiresAt])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(ORG_STAFF)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Event {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  description    String?
  date           DateTime
  venue          String?
  currency       String      @default("CAD")
  // Wall-clock zone for date. Display and datetime-local edits use this,
  // not the server or the viewer's zone. Defaults match the organizer org.
  timezone       String      @default("America/Toronto")
  status         EventStatus @default(DRAFT)
  etransferEmail String?
  zelleHandle    String?
  cashNote       String?
  logoUrl        String?
  imageUrls      String      @default("[]")
  brandColor     String?
  requireEntryBeforeFood Boolean @default(false) // food line needs an entry scan first
  organizationId String? // nullable during migration; backfilled by scripts/backfill-orgs.ts
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User        @relation("CreatedEvents", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  ticketTypes    TicketType[]
  mealOptions    MealOption[]
  sponsorAds     SponsorAd[]
  programItems   ProgramItem[]
  orders         Order[]
  scheduledReminders ScheduledReminder[]
  messageLogs      MessageLog[]
}

model TicketType {
  id            String  @id @default(cuid())
  eventId       String
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  priceCents    Int
  quantityTotal Int
  includesMeal  Boolean @default(false)
  sortOrder     Int     @default(0)
  orderItems    OrderItem[]
  tickets       Ticket[]
}

model MealOption {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String? // short public hint, e.g. "Veg - NOG"
  tag         String? // "veg" | "nonveg" — used for door routing badges
  sortOrder   Int     @default(0)
  orderItems OrderItem[]
  tickets    Ticket[]
}

model ProgramItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeLabel   String   // free text, e.g. "6:00 PM" or "Doors open"
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model SponsorAd {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String?
  linkUrl   String?
  tier      String   @default("SILVER")
  sortOrder Int      @default(0)
  impressions Int    @default(0)
  clicks      Int    @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyerName  String
  buyerEmail String?
  buyerPhone String?
  status     OrderStatus @default(PENDING_PAYMENT)
  payMethod  PayMethod
  sellerId   String?
  seller     User?       @relation("SellerOrders", fields: [sellerId], references: [id])
  totalCents Int
  notes      String?
  refCode    String?   @unique // short code the buyer puts in their e-transfer message
  inviteCode String?   @unique // public invite code for referral links (?invite=), distinct from the door refCode
  invitedBy  String? // inviteCode of the order that referred this buyer
  showOnWall Boolean   @default(false) // buyer opted into the public "who's going" wall
  confirmedAt           DateTime?
  confirmedById         String?
  confirmedBy           User?       @relation("ConfirmedOrders", fields: [confirmedById], references: [id], onDelete: SetNull)
  emergencyAdmittedAt   DateTime?
  emergencyAdmitReason  String?
  emergencyAdmittedById String?
  emergencyAdmittedBy   User?       @relation("EmergencyAdmits", fields: [emergencyAdmittedById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  items      OrderItem[]
  tickets    Ticket[]
  payments   Payment[]
}

model Payment {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         PaymentKind
  amountCents  Int
  method       String?
  reason       String?
  recordedById String?
  recordedBy   User?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([orderId])
}

model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId   String
  ticketType     TicketType  @relation(fields: [ticketTypeId], references: [id])
  qty            Int
  unitPriceCents Int
  holderName     String? // one attendee per item (qty 1); null = legacy grouped rows
  mealOptionId   String?
  mealOption     MealOption? @relation(fields: [mealOptionId], references: [id])
}

model Ticket {
  id           String       @id @default(cuid())
  code         String       @unique
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  holderName   String?
  mealOptionId String?
  mealOption   MealOption?  @relation(fields: [mealOptionId], references: [id])
  status       TicketStatus @default(ISSUED)
  checkedInAt  DateTime?
  foodCollectedAt DateTime?
  createdAt    DateTime     @default(now())
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String   // ORDER_RECEIVED | TICKETS_ISSUED | PAYMENT_REMINDER | EVENT_REMINDER | ORG_WELCOME
  channel        String   // EMAIL | WHATSAPP
  subject        String?  // email only
  body           String   // email: html/text with {{variables}}; whatsapp: human-readable text (params mapped separately)
  templateName   String?  // whatsapp only: approved Meta template name
  bodyParams     String?  // whatsapp only: JSON array of {{variable}} expressions for {{1}}, {{2}}...
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, key, channel])
}

model ScheduledReminder {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offsetMinutes  Int      // send this many minutes before the event starts
  channel        String   // EMAIL | WHATSAPP
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([eventId, enabled])
}

model MessageLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  kind           String   // TEMPLATE | REMINDER | BROADCAST | PAYMENT_NUDGE
  channel        String   // EMAIL | WHATSAPP
  recipient      String   // email or phone
  templateKey    String?
  orderId        String?  // when the message is about a specific order (dedup + audit)
  status         String   @default("SENT") // SENT | SKIPPED | FAILED
  sentAt         DateTime @default(now())

  @@index([organizationId, sentAt])
  @@index([eventId, kind, sentAt])
}

/**
 * Inbound payment notification (Interac email bot, future Zelle, etc.).
 * externalId is the provider reference (Interac CA… / Zelle confirmation)
 * and is unique per org for idempotency when the same mail hits a group inbox.
 */
model PaymentIntake {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalId     String
  method         String   // ETRANSFER | ZELLE
  amountCents    Int
  currency       String   @default("CAD")
  message        String?
  senderName     String?
  senderEmail    String?
  receivedAt     DateTime?
  status         String   // APPLIED | NEEDS_REVIEW | IGNORED | ALREADY_PROCESSED
  matchTier      String?  // CODE | EMAIL_AMOUNT | null
  orderId        String?
  paymentId      String?
  confirmed      Boolean  @default(false)
  payloadJson    String
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  resolvedById   String?

  @@unique([organizationId, externalId])
  @@index([organizationId, status])
}
