generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SELLER
  DOOR
}

enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  ORG_STAFF
  ORG_DOOR
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum PayMethod {
  ETRANSFER
  ZELLE
  CASH
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(SELLER) // platform-level role; per-org access comes from Membership
  emailVerified Boolean  @default(false) // true once the email address is confirmed
  createdAt     DateTime @default(now())
  soldOrders   Order[]  @relation("SellerOrders")
  events       Event[]  @relation("CreatedEvents")
  memberships  Membership[]
  verificationTokens VerificationToken[]
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the raw token — a DB leak must not grant resets
  type      String    // "VERIFY_EMAIL" | "RESET_PASSWORD"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logoUrl          String?
  tagline          String?
  supportEmail     String?
  supportPhone     String?
  timezone         String   @default("America/Toronto")
  brandColor       String?
  etransferEmail   String?
  zelleHandle      String?
  cashNote         String?
  plan             String   @default("FREE") // FREE | PRO
  stripeCustomerId String?
  stripeSubscriptionId String?
  subscriptionStatus String?  @default("NONE") // NONE | ACTIVE | PAST_DUE | CANCELED
  // Platform-admin overrides (null = use plan default)
  maxEventsOverride  Int?
  maxTicketsOverride Int?
  maxSeatsOverride   Int?
  createdAt        DateTime @default(now())
  memberships      Membership[]
  events           Event[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(ORG_STAFF)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Event {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  description    String?
  date           DateTime
  venue          String?
  currency       String      @default("CAD")
  status         EventStatus @default(DRAFT)
  etransferEmail String?
  zelleHandle    String?
  cashNote       String?
  logoUrl        String?
  imageUrls      String      @default("[]")
  brandColor     String?
  requireEntryBeforeFood Boolean @default(false) // food line needs an entry scan first
  organizationId String? // nullable during migration; backfilled by scripts/backfill-orgs.ts
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User        @relation("CreatedEvents", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  ticketTypes    TicketType[]
  mealOptions    MealOption[]
  sponsorAds     SponsorAd[]
  programItems   ProgramItem[]
  orders         Order[]
}

model TicketType {
  id            String  @id @default(cuid())
  eventId       String
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  priceCents    Int
  quantityTotal Int
  includesMeal  Boolean @default(false)
  sortOrder     Int     @default(0)
  orderItems    OrderItem[]
  tickets       Ticket[]
}

model MealOption {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  tag        String? // "veg" | "nonveg" — used for door routing badges
  sortOrder  Int     @default(0)
  orderItems OrderItem[]
  tickets    Ticket[]
}

model ProgramItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  timeLabel   String   // free text, e.g. "6:00 PM" or "Doors open"
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model SponsorAd {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String?
  linkUrl   String?
  tier      String   @default("SILVER")
  sortOrder Int      @default(0)
  impressions Int    @default(0)
  clicks      Int    @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyerName  String
  buyerEmail String?
  buyerPhone String?
  status     OrderStatus @default(PENDING_PAYMENT)
  payMethod  PayMethod
  sellerId   String?
  seller     User?       @relation("SellerOrders", fields: [sellerId], references: [id])
  totalCents Int
  notes      String?
  refCode    String?   @unique // short code the buyer puts in their e-transfer message
  inviteCode String?   @unique // public invite code for referral links (?invite=), distinct from the door refCode
  invitedBy  String? // inviteCode of the order that referred this buyer
  showOnWall Boolean   @default(false) // buyer opted into the public "who's going" wall
  createdAt  DateTime    @default(now())
  items      OrderItem[]
  tickets    Ticket[]
}

model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId   String
  ticketType     TicketType  @relation(fields: [ticketTypeId], references: [id])
  qty            Int
  unitPriceCents Int
  holderName     String? // one attendee per item (qty 1); null = legacy grouped rows
  mealOptionId   String?
  mealOption     MealOption? @relation(fields: [mealOptionId], references: [id])
}

model Ticket {
  id           String       @id @default(cuid())
  code         String       @unique
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  holderName   String?
  mealOptionId String?
  mealOption   MealOption?  @relation(fields: [mealOptionId], references: [id])
  status       TicketStatus @default(ISSUED)
  checkedInAt  DateTime?
  foodCollectedAt DateTime?
  createdAt    DateTime     @default(now())
}
